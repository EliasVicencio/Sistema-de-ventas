{
  "services": {
    "web": {
      "root": "frontend",
      "framework": "vite",
      "outputDirectory": "dist"
    },
    "api": {
      "root": "backend",
      "framework": "fastapi",
      "entrypoint": "main:app"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}